  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "jest tests/unit tests/api",
    "test:coverage": "jest tests/unit tests/api --coverage --collectCoverageFrom=src/**/*.js --coveragePathIgnorePatterns=src/server.js --coveragePathIgnorePatterns=src/user.repository.js --coveragePathIgnorePatterns=src/refreshToken.repository.js",
