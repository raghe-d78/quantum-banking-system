{
  "name": "api-gateway",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "NODE_ENV=test LOG_LEVEL=error jest --forceExit --testTimeout=10000",
    "test:coverage": "NODE_ENV=test LOG_LEVEL=error jest --forceExit --testTimeout=10000 --coverage --collectCoverageFrom=src/**/*.js --coveragePathIgnorePatterns=src/server.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.6",
    "express": "^4.19.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.0",
    "rate-limit-redis": "^4.2.0",
    "redis": "^4.7.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "moduleNameMapper": { "^/shared/(.*)$": "<rootDir>/../../shared/$1" }
  }
}
