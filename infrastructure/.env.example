# ──────────────────────────────────────────────────────────────────
# Quantum Banking System — environment template
# Copy to `infrastructure/.env` and fill in real values. `.env` is gitignored.
# ──────────────────────────────────────────────────────────────────

# ── Auth ─────────────────────────────────────────────────────────
# JWT_SECRET is shared by every service that verifies access tokens.
# Generate: openssl rand -base64 48
JWT_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_ROUNDS=12

# ── CockroachDB ──────────────────────────────────────────────────
DB_HOST=cockroachdb
DB_PORT=26257
DB_USER=root
DB_PASSWORD=
DB_SSL=disable            # "require" against a secure cluster

# ── Edge ─────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
TRUST_PROXY=false          # set true only behind Caddy (prod overlay does this)
AUTH_RL_MAX=20             # login attempts / IP / 15 min
API_RL_MAX=300             # requests / IP / minute
LOG_LEVEL=info

# ── Kafka / Redis ────────────────────────────────────────────────
KAFKA_BROKERS=kafka:9092
REDIS_URL=redis://redis:6379
BALANCE_CACHE_TTL=60
OUTBOX_POLL_MS=500
OUTBOX_BATCH=100

# ── Money rules ──────────────────────────────────────────────────
DAILY_TRANSFER_LIMIT_TND=10000
MAX_TX_AMOUNT=1000000

# ── KMS (BB84-derived AES-256-GCM keys) ──────────────────────────
KEY_TTL_SEC=300
KEY_ROUNDS=3
KEY_QUBITS=1024

# ── Quantum service ──────────────────────────────────────────────
# QUANTUM_BACKEND: "simulator" (default) or "ibm" (real hardware).
QUANTUM_BACKEND=simulator
QRNG_BUFFER_BYTES=4096

# ── Fraud decision policy: decision = (1-w)*classical + w*quantum ─
FRAUD_QUANTUM_WEIGHT=0.3
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_CRN=

# ── Document CV extension (Phase 7) ──────────────────────────────
# Master key wrapping per-document data keys (AES-256-GCM). Generate:
#   openssl rand -base64 32
DOCUMENT_MASTER_KEY=change_me_document_master_key
DOCUMENT_MAX_BYTES=10485760          # 10 MB upload cap
DOCUMENT_REVIEW_THRESHOLD=0.30       # risk ≥ → REVIEW
DOCUMENT_SUSPICIOUS_THRESHOLD=0.70   # risk ≥ → SUSPICIOUS (transaction held)
DOCUMENT_HOLD_ON_STATUS=SUSPICIOUS
DOCUMENT_HOLD_ON_REASONS=duplicate_document,amount_mismatch
TESSERACT_LANGS=eng+fra
UPLOAD_LIMIT=12mb

# ── Production HTTPS (Caddy overlay) ─────────────────────────────
CADDY_DOMAIN=localhost
CADDY_EMAIL=admin@example.com
